# Copier en .env et adapter. Le vrai .env n'est JAMAIS committé (cf. .gitignore).

# Port d'écoute de l'API
PORT=8080

# PostgreSQL — utilisé à partir du M2
DATABASE_URL=postgres://portal:portal@localhost:5432/portal?sslmode=disable

# Redis — utilisé à partir du M4
REDIS_URL=redis://localhost:6379
